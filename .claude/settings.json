{
  "extraKnownMarketplaces": {
    "sdlc-workflow": { "source": { "source": "github", "repo": "cjmcg10-lab/SDLC-Workflow" } }
  },
  "enabledPlugins": { "sdlc-workflow@sdlc-workflow": true },
  "permissions": {
    "allow": [
      "Bash(scripts/gates.sh)",
      "Bash(scripts/lint.sh)",
      "Bash(tests/hooks.test.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Edit(./.env)", "Edit(./.env.*)"]
  }
}
